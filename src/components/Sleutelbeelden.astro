---
/**
 * De sleutelbeelden van een vastgezette scène (CONTRACT 5.6).
 *
 * Wie geen beweging wil of geen JavaScript heeft, krijgt geen scrub maar deze
 * rijen: per stap van de scène één beeld met zijn tekst, gewoon onder elkaar.
 * Een beeld is de rozet in één stand (hero) of de poster van een shot (piek).
 * Het sleutelbeeld van een shot is zijn poster uit het manifest; er zijn geen
 * aparte sleutelbestanden.
 */
import Rozet, { type RozetStand } from './Rozet.astro';
import type { Locale } from '../i18n';
import { f3 } from '../i18n/f3';
import { alt, anker, poster, shot, type ShotNaam } from '../lib/media';

export interface Sleutelrij {
  /** De rozet in één stand, of de poster van een shot. */
  beeld: { rozet: RozetStand } | { shot: ShotNaam };
  /** Het klokwoord boven de kop (alleen hero). */
  label?: string;
  kop?: string;
  tekst: string;
}

interface Props {
  rijen: Sleutelrij[];
  locale: Locale;
  /** `rozet`: tekening naast de tekst. `foto`: beeld boven de tekst. */
  soort: 'rozet' | 'foto';
  class?: string;
}

const { rijen, locale, soort, class: klasse } = Astro.props;
const teksten = f3(locale);
---

<ol class:list={['sleutelbeelden', `sleutelbeelden-${soort}`, klasse]}>
  {
    rijen.map((rij) => (
      <li class="sleutelrij">
        {'rozet' in rij.beeld ? (
          <div class="sleutel-tekening">
            <Rozet stand={rij.beeld.rozet} maat={200} lijn={2} metPunt />
          </div>
        ) : (
          <figure class="sleutel-foto">
            <picture>
              {poster(rij.beeld.shot, 'm').avif ? (
                <source
                  media="(max-width: 47.9375rem)"
                  type="image/avif"
                  srcset={poster(rij.beeld.shot, 'm').avif}
                />
              ) : null}
              <source media="(max-width: 47.9375rem)" srcset={poster(rij.beeld.shot, 'm').pad} />
              {poster(rij.beeld.shot, 'd').avif ? (
                <source type="image/avif" srcset={poster(rij.beeld.shot, 'd').avif} />
              ) : null}
              <img
                src={poster(rij.beeld.shot, 'd').pad}
                width={poster(rij.beeld.shot, 'd').breedte}
                height={poster(rij.beeld.shot, 'd').hoogte}
                alt={alt(rij.beeld.shot, locale)}
                loading="lazy"
                decoding="async"
                style={`--anker-d:${anker(rij.beeld.shot, 'd')};--anker-m:${anker(rij.beeld.shot, 'm')}`}
              />
            </picture>
            {shot(rij.beeld.shot).bewerkt ? <figcaption>{teksten.mediaBewerkt}</figcaption> : null}
          </figure>
        )}
        <div class="sleutel-tekst">
          {rij.label ? <p class="sleutel-label">{rij.label}</p> : null}
          {rij.kop ? <p class="sleutel-kop">{rij.kop}</p> : null}
          <p class:list={[soort === 'foto' ? 'sleutel-slag' : 'sleutel-zin']}>{rij.tekst}</p>
        </div>
      </li>
    ))
  }
</ol>

<style>
  .sleutelbeelden {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 3rem;
  }
  .sleutelrij {
    display: grid;
    gap: 1.25rem;
    align-items: center;
  }
  .sleutel-tekening {
    width: min(12.5rem, 60%);
    color: var(--color-petrol-diep);
  }
  .sleutel-tekening :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }
  .sleutel-tekst {
    max-width: 30rem;
  }
  .sleutel-tekst p {
    margin: 0;
  }
  .sleutel-label {
    font-size: var(--text-klok);
    font-weight: 700;
    color: var(--color-petrol-diep);
  }
  .sleutel-kop {
    margin-top: 0.25rem;
    font-family: var(--font-kop);
    font-size: var(--text-h2);
    line-height: var(--text-h2--line-height);
    letter-spacing: var(--text-h2--letter-spacing);
    font-weight: var(--text-h2--font-weight);
    color: var(--color-inkt);
  }
  .sleutel-kop + .sleutel-zin {
    margin-top: 0.75rem;
  }
  .sleutel-zin {
    font-size: var(--text-lead);
    line-height: var(--text-lead--line-height);
    color: var(--color-inkt);
  }
  .sleutel-slag {
    font-family: var(--font-kop);
    font-size: var(--text-citaat);
    line-height: var(--text-citaat--line-height);
    font-weight: var(--text-citaat--font-weight);
    color: var(--color-inkt);
    max-width: 28ch;
  }
  .sleutel-foto {
    margin: 0;
  }
  .sleutel-foto img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: var(--anker-m);
    border-radius: var(--radius-vak);
  }
  .sleutel-foto figcaption {
    margin-top: 0.375rem;
    font-size: var(--text-label);
    color: var(--inkt-zacht);
  }
  @media (min-width: 48rem) {
    .sleutel-foto img {
      aspect-ratio: 16 / 9;
      object-position: var(--anker-d);
    }
  }
  @media (min-width: 64rem) {
    .sleutelbeelden-rozet .sleutelrij {
      grid-template-columns: minmax(0, 30rem) minmax(0, 30rem);
      gap: 4rem;
    }
    .sleutelbeelden-rozet .sleutel-tekening {
      width: 12.5rem;
      justify-self: center;
    }
  }
</style>
