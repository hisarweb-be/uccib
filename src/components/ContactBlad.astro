---
/**
 * De contactpagina (/iletisim/, F3-PLAN D2): het adresblad van DESIGNSYSTEEM 7.6
 * als hele pagina, met de paginakop als h1. Geen formulier, geen kaartbeeld en
 * het telefoonnummer in lead-maat, niet in de grote telefoonmaat.
 *
 * Eigen component en geen variant van home/AdresBlad.astro: dat blad hoort bij de
 * startpagina en heeft een andere eigenaar (regiebesluit keuring F3 PR D). De
 * opmaak volgt dat blad; een gedeelde basis is een punt voor de afwerking.
 *
 * Volgorde: bezoekadres, telefoon, e-mail, en alleen als het veld gevuld is:
 * WhatsApp, uren en routelink; daarna de rechtspersoon. Bezoekadres, telefoon en
 * e-mail komen uit `site.ts`; uren en coördinaten alleen uit
 * `src/data/kerngegevens.json`; naam, rechtsvorm, zetel en ondernemingsnummer
 * zoals de KBO ze toont (src/lib/rechtspersoon.ts). Zetel en bezoekadres
 * verschillen, dus elk heeft een eigen label. `SITE.openingHours` en `SITE.geo`
 * worden bewust niet gelezen: geen gegeven tonen dat UCCIB niet zelf bevestigde.
 */
import Rozet from './Rozet.astro';
import { type Locale } from '../i18n';
import { f3 } from '../i18n/f3';
import { SITE } from '../data/site';
import kern from '../data/kerngegevens.json';
import { rechtspersoon } from '../lib/rechtspersoon';

interface Props {
  locale: Locale;
  h1: string;
}

const { locale, h1 } = Astro.props;
const teksten = f3(locale);

const gevuld = (w: unknown): w is string => typeof w === 'string' && w.trim() !== '';
const uren = gevuld(kern.openingsuren) ? kern.openingsuren.trim() : null;
const rp = rechtspersoon(locale);
const route =
  typeof kern.lat === 'number' && typeof kern.lng === 'number'
    ? `https://www.openstreetmap.org/?mlat=${kern.lat}&mlon=${kern.lng}#map=17/${kern.lat}/${kern.lng}`
    : null;
const whatsapp = gevuld(SITE.whatsapp) ? `https://wa.me/${SITE.whatsapp.replace('+', '')}` : null;
---

<section class="adresblad">
  <div class="blad-merk" aria-hidden="true">
    <Rozet stand="vol" maat={32} />
    <span class="blad-woordmerk">uccib</span>
  </div>
  <h1 class="blad-kop">{h1}</h1>
  <p class="blad-intro">{teksten.contactIntro}</p>
  <address class="blad-adres">
    <div class="blad-groep">
      <p class="blad-regel">
        <span class="blad-label">{teksten.labelBezoekadres}</span>
        <span class="blad-waarde blad-lead">
          {rp.afkorting ? (
            <>
              {rp.afkorting}
              <br />
            </>
          ) : null}
          {SITE.street}
          <br />
          {SITE.postalCode} {SITE.city}
          <br />
          {teksten.land}
        </span>
      </p>
    </div>
    <div class="blad-groep">
      <p class="blad-regel">
        <span class="blad-label">{teksten.labelTelefoon}</span>
        <a class="blad-waarde blad-lead blad-cijfers" href={`tel:${SITE.phoneHref}`}>
          {SITE.phone}
        </a>
      </p>
      <p class="blad-regel">
        <span class="blad-label">{teksten.labelEmail}</span>
        <a class="blad-waarde blad-lead" href={`mailto:${SITE.email}`}>{SITE.email}</a>
      </p>
      {
        whatsapp ? (
          <p class="blad-regel">
            <a class="blad-waarde blad-tekstlink" href={whatsapp} target="_blank" rel="noopener">
              {teksten.whatsappLabel}
            </a>
          </p>
        ) : null
      }
    </div>
    {
      uren || route ? (
        <div class="blad-groep">
          {uren ? (
            <dl class="blad-regel">
              <dt class="blad-label">{teksten.labelUren}</dt>
              <dd class="blad-waarde blad-lead">{uren}</dd>
            </dl>
          ) : null}
          {route ? (
            <p class="blad-regel">
              <span class="blad-label">{teksten.labelRoute}</span>
              <a class="blad-waarde blad-tekstlink" href={route} target="_blank" rel="noopener">
                {teksten.routeTekst}
              </a>
            </p>
          ) : null}
        </div>
      ) : null
    }
    {
      rp.naam ? (
        <div class="blad-groep">
          <p class="blad-regel">
            <span class="blad-label">{teksten.labelRechtspersoon}</span>
            <span class="blad-waarde blad-voet">
              {rp.naam}
              {rp.afkorting ? ` (${rp.afkorting})` : null}
              {rp.rechtsvorm ? (
                <>
                  <br />
                  {rp.rechtsvorm}
                </>
              ) : null}
            </span>
          </p>
          {rp.zetel ? (
            <p class="blad-regel">
              <span class="blad-label">{teksten.labelZetel}</span>
              <span class="blad-waarde blad-voet">{rp.zetel}</span>
            </p>
          ) : null}
          {rp.kbo ? (
            <p class="blad-regel">
              <span class="blad-label">{teksten.labelKbo}</span>
              <span class="blad-waarde blad-voet">{rp.kbo}</span>
            </p>
          ) : null}
        </div>
      ) : null
    }
  </address>
</section>

<style>
  .adresblad {
    --blad: max(var(--spacing-marge), calc((100% - var(--container-blad)) / 2));
    padding: 5rem var(--blad) 5rem;
    background: var(--color-papier);
    color: var(--color-inkt);
    border-top: 1px solid var(--lijn);
  }
  .blad-merk {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    margin-bottom: 2rem;
    color: var(--color-petrol-diep);
  }
  .blad-woordmerk {
    font-family: var(--font-kop);
    font-size: var(--text-naam);
    font-weight: 600;
    line-height: 1;
  }
  .blad-kop {
    margin: 0;
    font-family: var(--font-kop);
    font-size: var(--text-h2);
    line-height: var(--text-h2--line-height);
    letter-spacing: var(--text-h2--letter-spacing);
    font-weight: var(--text-h2--font-weight);
  }
  .blad-intro {
    max-width: 40rem;
    margin: 1rem 0 0;
    font-size: var(--text-lead);
    line-height: var(--text-lead--line-height);
  }
  .blad-adres {
    margin-top: 2.5rem;
    font-style: normal;
  }
  .blad-groep {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--lijn);
  }
  .blad-regel {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin: 0;
  }
  .blad-label {
    font-size: var(--text-label);
    line-height: var(--text-label--line-height);
    letter-spacing: var(--text-label--letter-spacing);
    font-weight: var(--text-label--font-weight);
    color: var(--inkt-zacht);
  }
  .blad-waarde {
    margin: 0;
    color: var(--color-inkt);
  }
  .blad-lead {
    font-size: var(--text-lead);
    line-height: var(--text-lead--line-height);
    overflow-wrap: break-word;
  }
  .blad-cijfers {
    font-variant-numeric: tabular-nums;
  }
  .blad-voet {
    font-size: var(--text-voet);
    line-height: var(--text-voet--line-height);
  }
  a.blad-waarde {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    min-height: 44px;
    color: var(--color-petrol-diep);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-thickness: 1px;
  }
  @media (hover: hover) {
    a.blad-waarde:hover {
      color: var(--color-inkt);
    }
  }
  a.blad-waarde:focus-visible {
    outline: 3px solid var(--color-petrol-diep);
    outline-offset: 3px;
  }
  .blad-tekstlink {
    font-size: var(--text-body);
    font-weight: 600;
  }

  @media (min-width: 64rem) {
    .adresblad > * {
      margin-left: calc((100% - 11 * 1.5rem) / 12 + 1.5rem);
    }
    .blad-adres {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 3rem;
      max-width: 60rem;
    }
  }
</style>
