---
import { SITE } from '../data/site';
import Logo from './Logo.astro';
import { getDictionary, type Locale } from '../i18n';
import { pagePath } from '../i18n/config';
import type { Slug } from '../data/site';
import { isActiveSlug } from '../lib/actief';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);

/**
 * De quick links van het huidige footerblok, zonder de pagina's die nog geen
 * inhoud hebben (zie src/lib/actief.ts). Ze komen vanzelf terug
 * zodra hun slug daar verdwijnt.
 */
const QUICK_LINKS = (
  [
    { slug: 'hakkimizda', label: t.nav.hakkimizda },
    { slug: 'subelerimiz', label: t.nav.subelerimiz },
    { slug: 'bolge-derneklerimiz', label: t.nav['bolge-derneklerimiz'] },
    { slug: 'bagislar', label: t.nav.bagislar },
    { slug: 'iletisim', label: t.nav.iletisim },
  ] as ReadonlyArray<{ slug: Slug; label: string }>
).filter((link) => isActiveSlug(link.slug));

/** Onderaan de twee juridische pagina's; die hebben allebei echte inhoud. */
const LEGAL_LINKS = (
  [
    { slug: 'disclameer', label: t.nav.disclameer },
    {
      slug: 'cerez-politikasi-cookie-policy',
      label: t.nav['cerez-politikasi-cookie-policy'],
    },
  ] as ReadonlyArray<{ slug: Slug; label: string }>
).filter((link) => isActiveSlug(link.slug));
---

<footer class="site-footer">
  <div class="mx-auto w-full max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid gap-10 md:grid-cols-3">
      <div>
        <Logo locale={locale} class="footer-logo" />
        <p class="mt-4 max-w-xs text-sm">{t.siteTagline}</p>

        <ul class="mt-6 space-y-1 text-sm">
          {
            QUICK_LINKS.map((link) => (
              <li>
                <a class="footer-link" href={pagePath(locale, link.slug)}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="footer-heading">{t.footer.address}</h2>
        <address class="mt-3 not-italic leading-relaxed">
          {t.siteTaglineAlt}<br />
          {t.siteTagline}<br />
          {SITE.street}<br />
          {SITE.postalCode} {SITE.city}, België
        </address>
      </div>

      <div>
        <h2 class="footer-heading">{t.footer.contact}</h2>
        <dl class="mt-3 space-y-2 text-sm">
          <div>
            <dt class="inline font-semibold">{t.footer.phone}: </dt>
            <dd class="inline">
              <a class="footer-link" href={`tel:${SITE.phoneHref}`}>{SITE.phone}</a>
            </dd>
          </div>
          <div>
            <dt class="inline font-semibold">{t.footer.email}: </dt>
            <dd class="inline">
              <a class="footer-link" href={`mailto:${SITE.email}`}>{SITE.email}</a>
            </dd>
          </div>
        </dl>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="mx-auto flex w-full max-w-6xl flex-col gap-3 px-4 py-5 text-sm sm:px-6 md:flex-row md:items-center md:justify-between lg:px-8">
      <p>{t.footer.rights}</p>
      <nav aria-label={t.footerNavLabel}>
        <ul class="flex flex-wrap gap-x-5 gap-y-1">
          {
            LEGAL_LINKS.map((link) => (
              <li>
                <a class="footer-link" href={pagePath(locale, link.slug)}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-footer);
    color: var(--color-footer-text);
    border-top: 1px solid var(--color-footer-line);
  }

  .footer-logo {
    display: block;
    width: 224px;
    max-width: 100%;
    height: auto;
    background: #fff;
    border-radius: 6px;
    padding: 6px 10px;
  }

  .footer-heading {
    font-family: var(--font-body);
    font-size: var(--text-h4);
    font-weight: 700;
    color: var(--color-footer-text);
  }

  .footer-link {
    color: var(--color-footer-text);
    text-decoration: none;
  }

  .footer-link:hover,
  .footer-link:focus-visible {
    color: var(--color-brand-dark);
    text-decoration: underline;
  }

  .footer-bottom {
    border-top: 1px solid var(--color-footer-line);
  }
  /* Onderaan de pagina blijft de laatste regel anders onder de WhatsApp-knop staan
     (DESIGNSYSTEEM: zone 88 x 88 rechtsonder zonder tekst); op brede schermen
     eindigt de inhoud ruim links van die zone. */
  @media (max-width: 47.99rem) {
    .footer-bottom {
      padding-bottom: 4.5rem;
    }
  }
</style>
