---
/**
 * Een waardige lege staat.
 *
 * Waarom niet "binnenkort": dat is een belofte over een datum die niemand heeft
 * gemaakt. Dit paneel zegt wat er nu is, wat er nog niet is, en waar je terecht
 * kunt. Zonder uitroepteken en zonder spinner.
 */
interface Props {
  titel: string;
  tekst: string;
  actieLabel: string;
  actieHref: string;
}

const { titel, tekst, actieLabel, actieHref } = Astro.props;
---

<section class="rounded-2xl border border-line bg-surface-alt p-6 sm:p-8">
  <h2 class="text-h3">{titel}</h2>
  <p class="mt-3 max-w-[60ch] text-ink-muted">{tekst}</p>
  <a
    href={actieHref}
    class="mt-6 inline-flex min-h-[44px] items-center rounded-pill bg-brand-dark px-5 text-nav font-semibold text-surface no-underline transition-colors hover:bg-ink"
  >
    {actieLabel}
  </a>
</section>
