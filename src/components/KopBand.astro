---
/**
 * De kop van elke pagina: een rustige band met de h1, een korte inleiding en
 * optioneel één sterk beeld. De band loopt van rand tot rand, de inhoud houdt
 * dezelfde kolom als de rest van de site.
 */
import Beeld from './Beeld.astro';

interface Props {
  h1: string;
  intro?: string | null;
  bovenkop?: string;
  beeldSlug?: string;
  beeldAlt?: string;
  beeldSizes?: string;
  prioriteit?: boolean;
}

const {
  h1,
  intro,
  bovenkop,
  beeldSlug,
  beeldAlt = '',
  beeldSizes = '(min-width: 1024px) 460px, (min-width: 640px) 50vw, 100vw',
  prioriteit = false,
} = Astro.props;
---

<header class="relative overflow-hidden border-b border-line bg-surface-alt">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -top-32 right-[-6rem] h-80 w-80 rounded-full bg-brand-light blur-3xl"
  >
  </div>
  <div class="relative mx-auto w-full max-w-6xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8 lg:py-20">
    <div
      class:list={[
        beeldSlug && 'grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,0.8fr)] lg:items-center',
      ]}
    >
      <div>
        {bovenkop ? (
          <p class="mb-4 text-small font-semibold tracking-[0.18em] text-brand-dark uppercase">
            {bovenkop}
          </p>
        ) : (
          <span aria-hidden="true" class="mb-5 block h-1 w-16 rounded-full bg-brand"></span>
        )}
        <h1>{h1}</h1>
        {intro ? <p class="mt-5 max-w-[52ch] text-ink-muted">{intro}</p> : null}
      </div>
      {
        beeldSlug ? (
          <Beeld
            slug={beeldSlug}
            alt={beeldAlt}
            sizes={beeldSizes}
            klasse="h-auto w-full rounded-2xl shadow-sm"
            loading="eager"
            prioriteit={prioriteit}
          />
        ) : null
      }
    </div>
  </div>
</header>

<style>
  @media (prefers-reduced-motion: no-preference) {
    header h1 {
      animation: kop-in 0.5s ease-out both;
    }

    @keyframes kop-in {
      from {
        opacity: 0;
        transform: translateY(8px);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
  }
</style>
