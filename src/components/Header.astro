---
import { SITE } from '../data/site';
import Logo from './Logo.astro';
import { LOCALES, LOCALE_LABELS, LOCALE_TAGS, getDictionary, type Locale } from '../i18n';
import { pagePath } from '../i18n/config';
import type { Slug } from '../data/site';
import { isActiveSlug } from '../lib/actief';

interface Props {
  locale: Locale;
  /** Null op een pagina zonder eigen inhoud (404, concept): dan is er geen actief menu-item. */
  slug: Slug | null;
}

const { locale, slug } = Astro.props;
const t = getDictionary(locale);

/**
 * De hoofditems in dezelfde volgorde als het huidige menu. Een concept dat nog
 * geen inhoud heeft staat er niet in: een menulink naar een lege pagina is
 * precies wat we niet willen. Zodra F3 de inhoud levert, komt het item vanzelf
 * terug zodra de pagina in de CMS op actief staat.
 */
const MAIN_NAV = [
  'home',
  'hakkimizda',
  'haberler',
  'bolge-derneklerimiz',
  'subelerimiz',
  'namaz-vakitleri',
  'cuma-hutbesi',
] as const;

const mainNav = MAIN_NAV.map((key) => ({
  key,
  slug: (key === 'home' ? '' : key) as Slug,
  label: t.nav[key],
}))
  .filter((item) => isActiveSlug(item.slug))
  .map((item) => ({ ...item, href: pagePath(locale, item.slug) }));

/** De taalkiezer wijst op deze pagina; zonder slug (404) valt hij terug op de eigen taal. */
const languageHref = (other: Locale) =>
  slug === null ? (other === 'tr' ? '/' : `/${other}/`) : pagePath(other, slug);
---

<header>
  <div class="topbar on-dark">
    <div class="mx-auto flex w-full max-w-6xl flex-wrap items-center justify-between gap-x-6 gap-y-1 px-4 py-2 sm:px-6 lg:px-8">
      <div class="flex flex-wrap items-center gap-x-5 gap-y-1">
        <a class="topbar-link" href={`tel:${SITE.phoneHref}`}>
          <span class="sr-only">{t.footer.phone}: </span>{SITE.phone}
        </a>
        <a class="topbar-link" href={`mailto:${SITE.email}`}>
          <span class="sr-only">{t.footer.email}: </span>{SITE.email}
        </a>
      </div>
      <nav aria-label={t.langLabel} class="flex items-center gap-x-4">
        {
          LOCALES.map((other) => (
            <a
              class:list={['topbar-link', { 'is-current': other === locale }]}
              href={languageHref(other)}
              hreflang={LOCALE_TAGS[other].html}
              lang={LOCALE_TAGS[other].html}
              aria-current={other === locale ? 'true' : undefined}
            >
              {LOCALE_LABELS[other].native}
            </a>
          ))
        }
      </nav>
    </div>
  </div>

  <div class="site-header">
    <div class="mx-auto flex w-full max-w-6xl flex-col gap-4 px-4 py-4 sm:px-6 lg:flex-row lg:items-center lg:justify-between lg:gap-8 lg:px-8">
      <a class="logo-link" href={pagePath(locale, '')}>
        <Logo locale={locale} breedte={200} />
      </a>

      <nav aria-label={t.navLabel}>
        <ul class="flex flex-wrap items-center gap-x-1 gap-y-1 lg:justify-end">
          {
            mainNav.map((item) => (
              <li>
                <a
                  class:list={[
                    'nav-link',
                    { 'is-current': item.key === 'home' ? slug === '' : slug === item.key },
                  ]}
                  href={item.href}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      {
        /* De doneerknop verschijnt pas als /bagislar/ echte inhoud heeft (F5).
           Een opvallende knop naar een pagina die nog gebouwd wordt, kost meer
           vertrouwen dan hij oplevert. */
        isActiveSlug('bagislar') && (
          <a class="donate" href={pagePath(locale, 'bagislar')}>{t.donateCta}</a>
        )
      }
    </div>
  </div>
</header>

<style>
  .topbar {
    background: var(--color-brand-dark);
    color: #fff;
    font-size: var(--text-small);
  }

  .topbar-link {
    color: #fff;
    text-decoration: none;
  }

  /*
    Op een telefoon is de bovenbalk het eerste wat een duim tegenkomt. Daar is
    elke link 44 px hoog, de maat waar een vinger op mikt; met een muis blijft de
    balk compact. Gemeten op 17-11: de links waren 24 px hoog en dus net te klein
    (WCAG 2.5.8 vraagt 24, onze eigen lat staat op 44).
  */
  @media (pointer: coarse), (max-width: 767px) {
    .topbar-link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 44px;
      /* Atkinson is smaller dan Open Sans: "Türkçe" werd 43 px breed (18 nov). */
      min-width: 44px;
    }
  }

  .topbar-link:hover,
  .topbar-link:focus-visible {
    text-decoration: underline;
  }

  .topbar-link.is-current {
    font-weight: 700;
    text-decoration: underline;
  }

  .site-header {
    background: var(--color-surface);
    border-bottom: 4px solid var(--color-brand);
  }

  .logo-link {
    display: inline-flex;
  }

  /*
    De maat van het logo staat op het beeld zelf (`breedte` op `<Logo>`), niet
    hier. Gemeten op 17-11: deze regel raakte het logo nooit. Een scoped stijl
    geldt alleen voor elementen uit dit bestand, en de `<img>` staat in
    `Logo.astro`; het logo stond daardoor op zijn bronmaat van 560 px en vulde
    de halve kop. Op een telefoon hield alleen de `max-width: 100%` van Tailwind
    hem nog binnen, waardoor hij daar bijna het hele scherm breed werd.
  */

  .nav-link {
    display: inline-block;
    padding: 10px 11px;
    font-size: var(--text-nav);
    font-weight: 600;
    color: var(--color-ink);
    text-decoration: none;
  }

  .nav-link:hover,
  .nav-link:focus-visible {
    color: var(--color-brand-dark);
    text-decoration: underline;
  }

  .nav-link.is-current {
    color: var(--color-brand-dark);
    text-decoration: underline;
    text-underline-offset: 0.35em;
  }

  .donate {
    display: inline-block;
    align-self: flex-start;
    padding: 12px 28px;
    border-radius: var(--radius-pill);
    background: var(--color-brand-dark);
    color: #fff;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .donate:hover,
  .donate:focus-visible {
    background: var(--color-ink);
    text-decoration: none;
  }
</style>
