---
/**
 * De navigatiekop (DESIGNSYSTEEM 7.3): links de rozet als menuknop, dan het
 * woordmerk, rechts de taalkeuze en op desktop de giftlink. Papier, vast bovenaan,
 * een haarlijn zodra de pagina 8 px gescrold is. Geen topbalk meer: telefoon en
 * mail staan in het menublad, het adresblad en de voet.
 *
 * Het menu zelf is `RozetMenu`: altijd de zeven punten plus Bağış. De structuur
 * `header nav ul a` en `a.donate` blijft daarin bestaan (verify-mobiel).
 * Zonder JavaScript is er geen knop; dan staat het menu als lijst onder de balk.
 */
import { LOCALES, LOCALE_LABELS, LOCALE_TAGS, getDictionary, type Locale } from '../i18n';
import { pagePath } from '../i18n/config';
import { f3 } from '../i18n/f3';
import type { Slug } from '../data/site';
import RozetVoortgang from './RozetVoortgang.astro';
import RozetMenu from './RozetMenu.astro';

interface Props {
  locale: Locale;
  /** Null op een pagina zonder eigen inhoud (404, concept): dan is er geen actief menu-item. */
  slug: Slug | null;
}

const { locale, slug } = Astro.props;
const t = getDictionary(locale);
const teksten = f3(locale);

/** De taalkiezer wijst op deze pagina; zonder slug (404) valt hij terug op de eigen taal. */
const languageHref = (other: Locale) =>
  slug === null ? (other === 'tr' ? '/' : `/${other}/`) : pagePath(other, slug);
---

<header class="kop">
  <div class="balk">
    <button
      type="button"
      class="menuknop"
      data-menu-open
      aria-expanded="false"
      aria-controls="rozetmenu"
    >
      <RozetVoortgang maat={32} />
      <span class="menuknop-tekst">{teksten.rozetMenuOpen}</span>
    </button>

    <a class="woordmerk" href={pagePath(locale, '')}>uccib</a>

    <div class="rechts">
      <nav class="talen" aria-label={t.langLabel}>
        {
          LOCALES.map((other) => (
            <a
              class="taal"
              href={languageHref(other)}
              hreflang={LOCALE_TAGS[other].html}
              lang={LOCALE_TAGS[other].html}
              aria-current={other === locale ? 'true' : undefined}
            >
              {LOCALE_LABELS[other].short}
              <span class="sr-only"> {LOCALE_LABELS[other].native}</span>
            </a>
          ))
        }
      </nav>
      <a class="giftlink" href={pagePath(locale, 'bagislar')}>{t.donateCta}</a>
    </div>
  </div>

  <RozetMenu locale={locale} slug={slug} />
</header>

<style>
  .kop {
    background: var(--color-papier);
    border-bottom: 1px solid var(--lijn);
  }

  /* Vast bovenaan alleen met JavaScript: zonder JavaScript hangt het menu onder de balk. */
  :global(html.js-aan) .kop {
    position: sticky;
    top: 0;
    z-index: 30;
  }

  /*
    De haarlijn verschijnt na 8 px scroll. Een scroll-driven animatie op de
    randkleur, geen JavaScript; kan de browser dat niet of vraagt de bezoeker
    minder beweging, dan staat de lijn er gewoon altijd.
  */
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .kop {
        animation: kop-lijn linear both;
        animation-timeline: scroll(root);
        animation-range: 0 8px;
      }
    }
  }

  @keyframes kop-lijn {
    from {
      border-bottom-color: transparent;
    }
    to {
      border-bottom-color: var(--lijn);
    }
  }

  .balk {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    max-width: var(--container-blad);
    min-height: var(--kop-hoogte);
    margin-inline: auto;
    padding-inline: var(--spacing-marge);
  }

  .menuknop {
    display: none;
    align-items: center;
    gap: 0.5rem;
    min-width: 44px;
    min-height: 44px;
    margin-inline-start: -6px;
    padding: 0 6px;
    border: 0;
    border-radius: var(--radius-vak);
    background: transparent;
    color: var(--color-inkt);
    font: inherit;
    font-size: var(--text-klok);
    font-weight: 600;
    cursor: pointer;
  }

  :global(html.js-aan) .menuknop {
    display: inline-flex;
  }

  /* 32 px op een telefoon, 40 px vanaf 1024 (DESIGNSYSTEEM 5.4). */
  @media (min-width: 64rem) {
    .menuknop :global(.rozet) {
      width: 40px;
      height: 40px;
    }
  }

  .menuknop:hover .menuknop-tekst,
  .menuknop:focus-visible .menuknop-tekst {
    color: var(--color-petrol-diep);
    text-decoration: underline;
  }

  .woordmerk {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-petrol-diep);
    font-family: var(--font-kop);
    font-size: var(--text-naam);
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
  }

  .rechts {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-inline-start: auto;
  }

  .talen {
    display: flex;
  }

  .taal {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    color: var(--color-inkt);
    font-size: var(--text-klok);
    font-weight: 500;
    text-decoration: none;
  }

  .taal:hover,
  .taal:focus-visible {
    color: var(--color-petrol-diep);
    text-decoration: underline;
  }

  .taal[aria-current='true'] {
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25em;
  }

  /* Op een telefoon staat de giftknop in het menublad en onder de naam, niet in de kop. */
  .giftlink {
    display: none;
  }

  @media (min-width: 64rem) {
    .giftlink {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      padding: 0 1.25rem;
      border: 2px solid var(--color-petrol-diep);
      border-radius: var(--radius-vak);
      color: var(--color-petrol-diep);
      font-size: var(--text-knop);
      font-weight: 600;
      text-decoration: none;
      white-space: nowrap;
    }

    .giftlink:hover,
    .giftlink:focus-visible {
      background: var(--color-petrol-diep);
      color: var(--color-wit);
    }
  }

  /* Zolang het blad open is, valt de WhatsApp-knop weg: hij zou het blad bedekken. */
  :global(html.menu-open .wa-wrap) {
    display: none;
  }
</style>
