---
/**
 * De dienstenindex (STORYBOARD D08 tot D10, M05; DESIGNSYSTEEM 7.4).
 *
 * Elke dienst uit `f3.diensten[]` is één regel: titel, één regel uitleg en een
 * pijl, met een haarlijn eronder. Geen nummer, pictogram of kaartvak, en nergens
 * een telwoord. Alle regels staan er altijd; het aantal volgt de bron.
 *
 * Doel van een regel (CONTRACT 4.2): de eigen pagina in de eigen taal. Staat die
 * pagina uit, dan linkt de regel toch naar haar eigen adres (de binnenkort-pagina,
 * status 200, met de eerlijke uitleg uit f3) en blijft de uitleg naast de titel
 * de gewone diensttekst: wat de dienst is, niet wat er nog niet is. Het merkje
 * `dienstenBinnenkort` zegt in één woord dat de eigen pagina nog dicht is. Zo'n
 * regel draagt `data-binnenkort="<slug>"`: de linkkeuring laat alleen dan een link
 * naar die ene concept-slug toe. Bağış gaat naar `#steun` op deze pagina.
 *
 * Vanaf 64rem staat de rozet klein in de linkermarge; daaronder staat ze in stand
 * vol, 56 px, statisch boven de kop (M05). De regel die het midden van het scherm
 * passeert, wordt "aangewezen" (lijn petrol-diep). Dat doet een kleine observer;
 * zonder JavaScript is er geen aangewezen regel en is de index volledig.
 *
 * Beweging (DESIGNSYSTEEM 6.3, 6.4): elke regel komt één keer binnen, 10 px
 * omhoog en opacity 0 naar 1 in `duur-kom` met `ease-uit`, zodra ze 10 % in beeld
 * is; regels die samen binnenkomen volgen elkaar op met 50 ms, hooguit zeven
 * stappen (een achtste komt mee met de zevende). D10: komt `open-deur` voor de
 * helft van het scherm in beeld, dan verliest de margerozet haar vlakken (stand vol
 * naar open-kern) in `duur-lijn` met `ease-in-uit`; terug omhoog keert ze terug.
 * Beide standen liggen op elkaar en wisselen alleen met opacity. De beginstand
 * zet het script zelf (`data-kom` op de sectie): zonder JavaScript of bij minder
 * beweging staat alles er meteen.
 */
import Rozet from '../Rozet.astro';
import { type Locale } from '../../i18n';
import { pagePath, isSlug } from '../../i18n/config';
import { f3 } from '../../i18n/f3';
import { conceptSlugs } from '../../lib/actief';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const teksten = f3(locale);
const uit = new Set<string>(conceptSlugs());

const regels = teksten.diensten.map((dienst) => {
  const slug = dienst.href.replace(/^\//, '').split(/[/#?]/)[0] ?? '';
  if (slug === 'bagislar') return { ...dienst, doel: '#steun', binnenkort: undefined, uitleg: dienst.tekst, dicht: false };
  if (!isSlug(slug)) throw new Error(`DienstenIndex: onbekend doel ${dienst.href} voor "${dienst.titel}".`);
  /* Een pagina die uit staat: de regel houdt haar eigen diensttekst en krijgt
     het merkje "binnenkort" (zie de kop hierboven). */
  const dicht = uit.has(slug);
  return {
    ...dienst,
    doel: pagePath(locale, slug),
    binnenkort: dicht ? slug : undefined,
    uitleg: dienst.tekst,
    dicht,
  };
});
---

{
  regels.length > 0 ? (
    <section id="diensten-index" data-sectie="diensten-index" class="diensten-index">
      <div class="index-rozet-mobiel" aria-hidden="true">
        <Rozet stand="vol" maat={56} />
      </div>
      <div class="index-rozet" aria-hidden="true">
        <span class="index-rozet-standen">
          <Rozet stand="vol" maat={32} class="stand-vol" />
          <Rozet stand="open-kern" maat={32} class="stand-open" />
        </span>
      </div>
      <div class="index-plaat">
        <h2 class="index-kop">{teksten.dienstenKop}</h2>
        <ul class="index-lijst" role="list">
          {regels.map((regel) => (
            <li class="index-regel">
              <a class="index-link" href={regel.doel} data-binnenkort={regel.binnenkort}>
                <span class="index-titel">{regel.titel}</span>
                <span class="index-uitleg">{regel.uitleg}</span>
                {regel.dicht ? <span class="index-merk">{teksten.dienstenBinnenkort}</span> : null}
                <svg class="index-pijl" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true" focusable="false">
                  <path d="M3 12h16M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  ) : null
}

<script>
  /* De regel die het midden van het scherm passeert, wordt aangewezen (alleen kleur). */
  const regels = [...document.querySelectorAll<HTMLElement>('.diensten-index .index-regel')];
  if (regels.length > 0 && 'IntersectionObserver' in window) {
    const kijker = new IntersectionObserver(
      (items) => {
        for (const item of items) {
          if (!item.isIntersecting) continue;
          regels.forEach((r) => r.toggleAttribute('data-aangewezen', r === item.target));
        }
      },
      { rootMargin: '-50% 0px -50% 0px' },
    );
    regels.forEach((r) => kijker.observe(r));
  }

  const sectie = document.querySelector<HTMLElement>('.diensten-index');
  const beweging = matchMedia('(prefers-reduced-motion: no-preference)').matches;

  /* Binnenkomst: één keer per regel, start als de regel 10 % in beeld is. */
  if (sectie && beweging && 'IntersectionObserver' in window) {
    const STAP = 50;
    const MAX_STAPPEN = 6;
    const kom = new IntersectionObserver(
      (items) => {
        let stap = 0;
        for (const item of items) {
          if (!item.isIntersecting) continue;
          const regel = item.target as HTMLElement;
          regel.style.setProperty('--kom-wacht', `${Math.min(stap, MAX_STAPPEN) * STAP}ms`);
          regel.setAttribute('data-binnen', '');
          kom.unobserve(regel);
          stap += 1;
        }
      },
      { rootMargin: '0px 0px -10% 0px' },
    );
    sectie.setAttribute('data-kom', '');
    regels.forEach((r) => kom.observe(r));
  }

  /* D10: open-deur voor de helft in beeld = de margerozet verliest haar vlakken. */
  const deur = document.querySelector<HTMLElement>('[data-sectie="open-deur"]');
  if (sectie && deur && 'IntersectionObserver' in window) {
    new IntersectionObserver(
      ([item]) => {
        if (!item) return;
        const voorbij = item.isIntersecting || item.boundingClientRect.top < 0;
        sectie.toggleAttribute('data-d10', voorbij);
      },
      { rootMargin: '0px 0px -50% 0px' },
    ).observe(deur);
  }
</script>

<style>
  .diensten-index {
    --blad: max(var(--spacing-marge), calc((100% - var(--container-blad)) / 2));
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: calc(100svh - var(--kop-hoogte));
    padding: 4rem var(--blad) 3rem;
    /* Het blad onder de plaat: het witte vlak van de pagina zelf (slice 4a). Een
       plaat van papier 92 % is op papier onzichtbaar; op dit vlak leest ze als
       een vel dat op de wand ligt, net als de cartouche op de film. */
    background: var(--color-wit);
    color: var(--color-inkt);
  }
  .index-rozet {
    display: none;
  }
  /* Onder 64rem (STORYBOARD M05 en 0.2, DESIGNSYSTEEM 4.1): de rozet staat niet in
     een marge maar boven de sectiekop, stand vol, 56 px, links uitgelijnd en
     statisch. Vrije ruimte rondom minstens een achtste van haar diameter (4.3). */
  .index-rozet-mobiel {
    align-self: flex-start;
    margin: 0 0 1.5rem;
  }
  /* De plaat: papier 92 % met een petrol haarline van 1 px boven en onder, in
     de taal van de cartouche boven de vouw. Geen verloop, geen schaduw, geen
     afgeronde hoeken: de plaat begint hard. De haarlijnen zijn eigen
     achtergrondlagen van 1 px en geen `border`, zodat ze de doos niet
     verschuiven. Het witte blad van de sectie blijft boven en onder de plaat
     open; daar komt het ritme vandaan. */
  .index-plaat {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 1.5rem 0 0;
    background-color: var(--plaat);
    background-image:
      linear-gradient(var(--color-petrol-diep), var(--color-petrol-diep)),
      linear-gradient(var(--color-petrol-diep), var(--color-petrol-diep));
    background-repeat: no-repeat;
    background-position:
      top left,
      bottom left;
    background-size:
      100% 1px,
      100% 1px;
  }
  /* De laatste regel levert geen eigen haarlijn meer: daar ligt de onderlijn van
     de plaat, en twee lijnen op dezelfde pixel werd een dubbele rand. */
  .index-regel:last-child .index-link {
    box-shadow: none;
  }
  /* De kopzone blijft rustig: geen eigen vlak, geen kader, alleen ruimte tot de
     eerste regel van de lijst. */
  .index-kop {
    margin: 0 0 2rem;
    font-family: var(--font-kop);
    font-size: var(--text-h2);
    line-height: var(--text-h2--line-height);
    letter-spacing: var(--text-h2--letter-spacing);
    font-weight: var(--text-h2--font-weight);
  }
  .index-lijst {
    flex: 1;
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .index-regel {
    flex: 1 0 auto;
    display: flex;
  }
  .index-link {
    flex: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: 1rem;
    row-gap: 0.5rem;
    align-content: center;
    min-height: 6rem;
    padding: 1.5rem 0;
    color: var(--color-inkt);
    text-decoration: none;
    position: relative;
    box-shadow: inset 0 -1px 0 var(--lijn);
  }
  /* De petrol lijn van 2 px ligt klaar over de haarlijn en verschijnt met opacity
     (DESIGNSYSTEEM 6: alleen transform en opacity bewegen). */
  .index-link::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 2px;
    background: var(--color-petrol-diep);
    opacity: 0;
    transition: opacity var(--duur-kort) var(--ease-uit);
    pointer-events: none;
  }
  .index-titel {
    grid-column: 1;
    font-family: var(--font-kop);
    font-size: var(--text-dienst);
    line-height: var(--text-dienst--line-height);
    letter-spacing: var(--text-dienst--letter-spacing);
    font-weight: var(--text-dienst--font-weight);
    overflow-wrap: normal;
    hyphens: manual;
    transition: color var(--duur-kort) var(--ease-uit);
  }
  .index-uitleg {
    grid-column: 1 / -1;
    font-family: var(--font-tekst);
    font-size: var(--text-body);
    line-height: 1.5;
    color: var(--color-inkt);
  }
  /* Het merkje bij een dienst waarvan de eigen pagina nog dicht is: één woord in
     de kleine letter, zacht van kleur, op dezelfde regel als de uitleg eronder.
     Het zegt wat er is, niet wat er nog komt. */
  .index-merk {
    grid-column: 1 / -1;
    justify-self: start;
    font-family: var(--font-tekst);
    font-size: var(--text-label);
    line-height: var(--text-label--line-height);
    letter-spacing: var(--text-label--letter-spacing);
    font-weight: var(--text-label--font-weight);
    color: var(--inkt-zacht);
  }
  .index-pijl {
    grid-column: 2;
    grid-row: 1;
    align-self: center;
    width: 1.75rem;
    height: 1.75rem;
    color: var(--color-petrol-diep);
    transition: transform var(--duur-kort) var(--ease-uit);
  }
  .index-link:focus-visible::after,
  .index-regel[data-aangewezen] .index-link::after {
    opacity: 1;
  }

  @media (hover: hover) {
    .index-link:hover::after {
      opacity: 1;
    }
    .index-link:hover .index-titel {
      color: var(--color-petrol-diep);
    }
    .index-link:hover .index-pijl {
      transform: translateX(4px);
    }
  }
  .index-link:focus-visible {
    outline: 3px solid var(--color-petrol);
    outline-offset: 2px;
  }
  .index-link:active {
    transform: translateY(1px);
  }

  /* Binnenkomst (6.3): de beginstand alleen als het script `data-kom` zette. */
  .diensten-index[data-kom] .index-regel {
    opacity: 0;
    transform: translateY(10px);
  }
  .diensten-index[data-kom] .index-regel[data-binnen] {
    opacity: 1;
    transform: none;
    transition:
      opacity var(--duur-kom) var(--ease-uit) var(--kom-wacht, 0ms),
      transform var(--duur-kom) var(--ease-uit) var(--kom-wacht, 0ms);
  }

  @media (min-width: 64rem) {
    .index-rozet-mobiel {
      display: none;
    }
    .index-rozet {
      display: block;
      position: absolute;
      top: 4rem;
      bottom: 3rem;
      left: calc(var(--blad) / 2 - 16px);
      color: var(--color-petrol-diep);
    }
    .index-rozet-standen {
      position: sticky;
      top: calc(50svh - 16px);
      display: grid;
    }
    .index-rozet-standen :global(svg) {
      grid-area: 1 / 1;
      transition: opacity var(--duur-lijn) var(--ease-in-uit);
    }
    .index-rozet-standen :global(.stand-open),
    .diensten-index[data-d10] .index-rozet-standen :global(.stand-vol) {
      opacity: 0;
    }
    .diensten-index[data-d10] .index-rozet-standen :global(.stand-open) {
      opacity: 1;
    }
    /* De plaat begint op de tweede rasterkolom, zodat de rozet vrij in de marge
       staat en de haarline van de plaat haar rechterbuur is. */
    .index-plaat {
      margin-left: calc((100% - 11 * 1.5rem) / 12 + 1.5rem);
    }
    .index-link {
      grid-template-columns: repeat(11, minmax(0, 1fr));
      column-gap: 1.5rem;
      align-items: center;
      min-height: 7rem;
      padding: 2rem 0;
    }
    .index-titel {
      grid-column: 1 / 7;
    }
    .index-uitleg {
      grid-column: 7 / 10;
      grid-row: 1;
    }
    .index-merk {
      grid-column: 10;
      grid-row: 1;
      align-self: center;
      justify-self: end;
    }
    .index-pijl {
      grid-column: 11;
      justify-self: end;
    }
  }
</style>
