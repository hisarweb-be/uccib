---
/**
 * Piek: de ruimtes (STORYBOARD D12 tot D19, M07 tot M10; pin 5 schermhoogten).
 *
 * Eén DOM voor twee toestanden:
 * - stil (geen JavaScript, beperkte beweging): de kop, de sleutelbeelden (poster
 *   per ruimte met zijn zin) en de twee knoppen, gewoon onder elkaar;
 * - beweging: het podium staat vast, de kern van de rozet gaat open op de eerste
 *   ruimte en `--piek-p` wisselt de ruimtes en de zinnen.
 *
 * Wat er per shot te zien is, bepaalt `vormVan` in `lib/media.ts`, alleen uit wat
 * er in het manifest ligt (nooit uit het veld `status`):
 * - `film`: de film loopt mee met de scrub (video, geladen als de sectie nadert)
 *   en de vermelding staat erbij als het een AI-film is;
 * - `poster`: de echte foto beweegt in code. Ze schuift door het venster van de
 *   rozet en er trekt één warme lichtvlek door de ruimte: bij `p1` over de wand
 *   van de gebedsruimte, bij `p2` over tafels en vloer (het raam blijft
 *   ongemoeid), bij `p3` over de loper de zaal in (de deur en de trap blijven
 *   ongemoeid). Geen vermelding, want er is geen AI in beeld.
 *
 * De rozet draagt het beeld: haar kern is het venster waardoor je de ruimte ziet.
 * Bij elke wissel knijpt ze helemaal dicht, draait een slag en gaat open op de
 * volgende ruimte. Hoe ver ze opengaat, volgt uit de eigen pixels van de foto
 * (`eigenBreedte`): een foto wordt nooit groter dan 110 % getoond. Is ze te klein
 * voor het hele scherm, dan blijft ze in het venster; een grotere poster gaat
 * vanzelf schermvullend;
 * - `weg`: het shot ontbreekt in het manifest. Dan is er geen laag, geen zin, geen
 *   vermelding en geen sleutelrij voor, en valt zijn stuk uit de scrollweg (`piekPlan`
 *   in `lib/piekplan.ts`): de pin wordt korter en de drempels per element (inline
 *   `--in`/`--uit`) volgen. Zonder `p4` is de pin zo 4,6 schermhoogten. Een
 *   plaatshouderbeeld komt nooit in beeld (keuring F2b, herstelpunt 2).
 */
import MediaVermelding from '../MediaVermelding.astro';
import Sleutelbeelden, { type Sleutelrij } from '../Sleutelbeelden.astro';
import { getDictionary, type Locale } from '../../i18n';
import { f3 } from '../../i18n/f3';
import { alt, anker, eigenBreedte, film, poster, shot, vormVan, type ShotNaam } from '../../lib/media';
import { lijnen } from './rozetpad';
import { piekPlan } from '../../lib/piekplan';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const teksten = f3(locale);
const [opening, ...slagen] = teksten.piekSlagen;

const plan = piekPlan(
  (['p1', 'p2', 'p3', 'p4'] as const).map((naam) => ({
    naam,
    van: shot(naam).fase.van,
    tot: shot(naam).fase.tot,
    aanwezig: vormVan(naam) !== 'weg',
  })),
  slagen.length,
);
const lagen = plan.lagen.map((laag) => {
  const naam = laag.naam as ShotNaam;
  const vorm = vormVan(naam);
  const d = film(naam, 'd');
  const m = film(naam, 'm');
  return {
    ...laag,
    naam,
    fase: shot(naam).fase,
    vorm,
    eigen: `${eigenBreedte(naam, 'd')},${eigenBreedte(naam, 'm')}`,
    aspect: `${poster(naam, 'd').breedte / poster(naam, 'd').hoogte},${poster(naam, 'm').breedte / poster(naam, 'm').hoogte}`,
    /* Een frame-reeks hoort bij de hero; hier scrubt alleen een video. */
    film: vorm === 'film' && (d || m) ? JSON.stringify({ d, m }) : null,
  };
});
const { lengte } = plan;

/* Zonder beweging: per ruimte met een zin haar poster en die zin. */
const rijen: Sleutelrij[] = plan.zinnen.map((zin) => ({
  beeld: { shot: zin.naam as ShotNaam },
  tekst: slagen[zin.tekst] ?? '',
}));
---

<section
  id="piek-ruimtes"
  class="piek-ruimtes"
  data-sectie="piek-ruimtes"
  data-lengte={lengte}
  data-sprongen={plan.sprongen.length ? JSON.stringify(plan.sprongen) : undefined}
  style={`--piek-lengte:${lengte}`}
>
  <div class="sh-maat" aria-hidden="true"></div>
  <div class="piek-podium">
    <div class="piek-beeld alleen-beweging">
      <div class="piek-kern">
        <div class="piek-fotos">
          {
            lagen.map(({ naam, slot, fase, a, b, in: laagIn, vorm, eigen, aspect, film: filmData }) => (
              <div
                class="piek-laag"
                data-laag={slot}
                data-vorm={vorm}
                data-a={a}
                data-b={b}
                data-eigen={eigen}
                data-aspect={aspect}
                style={`--a:${a};--b:${b};--in:${laagIn}`}
              >
                <div class="piek-raam">
                  <picture>
                    {poster(naam, 'm').avif ? (
                      <source media="(max-width: 47.9375rem)" type="image/avif" srcset={poster(naam, 'm').avif} />
                    ) : null}
                    <source media="(max-width: 47.9375rem)" srcset={poster(naam, 'm').pad} />
                    {poster(naam, 'd').avif ? <source type="image/avif" srcset={poster(naam, 'd').avif} /> : null}
                    <img
                      class="piek-foto"
                      data-shot={naam}
                      src={poster(naam, 'd').pad}
                      width={poster(naam, 'd').breedte}
                      height={poster(naam, 'd').hoogte}
                      alt={alt(naam, locale)}
                      loading="lazy"
                      decoding="async"
                      style={`--anker-d:${anker(naam, 'd')};--anker-m:${anker(naam, 'm')}`}
                    />
                  </picture>
                  {filmData ? (
                    <video
                      class="piek-film"
                      data-film-shot={naam}
                      data-film={filmData}
                      data-van={fase.van}
                      data-tot={fase.tot}
                      muted
                      playsinline
                      preload="none"
                      aria-hidden="true"
                      tabindex="-1"
                      style={`--anker-d:${anker(naam, 'd')};--anker-m:${anker(naam, 'm')}`}
                    />
                  ) : null}
                  {vorm === 'poster' ? <span class="piek-licht" data-licht={naam} aria-hidden="true" /> : null}
                </div>
              </div>
            ))
          }
        </div>
      </div>
      {/* Het venster: papier met de kern van de rozet als gat, dat met transform opengaat. */}
      <svg class="piek-masker" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
        <g>
          <path fill-rule="evenodd" d={`M-1000 -1000H1100V1100H-1000Z${lijnen.kern}`}></path>
        </g>
      </svg>
      <svg class="piek-rozet" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
        <g>
          <path d={lijnen.cirkel}></path>
          <path d={lijnen.a}></path>
          <path d={lijnen.b}></path>
          <path d={lijnen.binnen}></path>
          <path d={lijnen.kern}></path>
        </g>
      </svg>
      {/* De vermeldingen boven het venster: nooit door het papier afgeknipt, ook niet bij een wissel. */}
      {
        lagen.map(({ naam, slot, plekIn, plekUit }) => (
          <div class="piek-plek" data-laag={slot} style={`--in:${plekIn};--uit:${plekUit}`}>
            <MediaVermelding shot={naam} locale={locale} class="piek-vermelding" />
          </div>
        ))
      }
    </div>

    <h2 class="piek-kop">{opening}</h2>

    <div class="piek-tekst alleen-beweging">
      <p class="piek-klein" aria-hidden="true">
        <span>{opening}</span>
        {
          plan.klein.map(({ tekst, in: kleinIn }) =>
            slagen[tekst] ? <span data-klein style={`--in:${kleinIn}`}> {slagen[tekst]}</span> : null,
          )
        }
      </p>
      <div class="piek-slagen">
        {
          plan.zinnen.map(({ tekst, in: zinIn, uit }) => (
            <p class="piek-slag" data-slag={tekst + 1} style={`--in:${zinIn};--uit:${uit}`}>
              {slagen[tekst]}
            </p>
          ))
        }
      </div>
      <div class="piek-knoppen" data-piek-knoppen="scene">
        <a class="knop knop-eerst" href="#steun">{t.donateCta}</a>
        <a class="knop knop-tweede" href="#contact">{teksten.contactKop}</a>
      </div>
    </div>

    <div class="piek-stil alleen-stil">
      <Sleutelbeelden rijen={rijen} locale={locale} soort="foto" class="piek-sleutels" />
      <div class="piek-knoppen">
        <a class="knop knop-eerst" href="#steun">{t.donateCta}</a>
        <a class="knop knop-tweede" href="#contact">{teksten.contactKop}</a>
      </div>
    </div>
  </div>
</section>
