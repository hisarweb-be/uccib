---
/**
 * Piek: de ruimtes (STORYBOARD D12 tot D19, M07 tot M10; pin 5 schermhoogten).
 *
 * Eén DOM voor twee toestanden:
 * - stil (geen JavaScript, beperkte beweging): de kop, de sleutelbeelden (poster
 *   per ruimte met zijn zin) en de twee knoppen, gewoon onder elkaar;
 * - beweging: het podium staat vast, de kern van de rozet gaat open op de eerste
 *   ruimte en `--piek-p` wisselt de ruimtes en de zinnen.
 *
 * Wat er per shot te zien is, bepaalt `vormVan` in `lib/media.ts`, alleen uit wat
 * er in het manifest ligt (nooit uit het veld `status`):
 * - `film`: de film loopt mee met de scrub (video, geladen als de sectie nadert)
 *   en de vermelding staat erbij als het een AI-film is;
 * - `poster`: de echte foto beweegt in code. Ze zoomt langzaam in naar haar
 *   anker, de randen gaan open van donker naar licht (diepte) en er trekt warm
 *   licht door de ruimte: bij `p1` over de wand van de gebedsruimte, bij `p2` en
 *   `p3` over tafels en vloer (het raam, de deur en de trap blijven ongemoeid).
 *   Over het open beeld blijft de rozet als dunne lichte lijn meedraaien: zij
 *   opent elke ruimte en houdt de drie bij elkaar. Geen vermelding, want er is
 *   geen AI in beeld;
 * - `weg`: ontbreekt `p4`, dan valt zijn stuk (0,78 tot 0,86) uit de scrollweg: de pin
 *   is dan 4,6 schermhoogten en de standen in CSS blijven dezelfde, omdat het
 *   script de sprong overslaat.
 */
import MediaVermelding from '../MediaVermelding.astro';
import Sleutelbeelden, { type Sleutelrij } from '../Sleutelbeelden.astro';
import { getDictionary, type Locale } from '../../i18n';
import { f3 } from '../../i18n/f3';
import { alt, anker, film, poster, shot, vormVan, type ShotNaam } from '../../lib/media';
import { KERN_INKEPING, KERN_PUNT, hoeken, lijnen } from './rozetpad';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const teksten = f3(locale);
const [opening, ...slagen] = teksten.piekSlagen;

/** De pin in schermhoogten met alle shots, en het stuk van `p4` daarin. */
const PIN = 5;
const P4 = [0.78, 0.86] as const;

const heeftP4 = vormVan('p4') !== 'weg';
const namen: ShotNaam[] = heeftP4 ? ['p1', 'p2', 'p3', 'p4'] : ['p1', 'p2', 'p3'];
const lagen = namen.map((naam, i) => {
  const vorm = vormVan(naam);
  const d = film(naam, 'd');
  const m = film(naam, 'm');
  return {
    naam,
    laag: i + 1,
    fase: shot(naam).fase,
    vorm,
    /* Een frame-reeks hoort bij de hero; hier scrubt alleen een video. */
    film: vorm === 'film' && (d || m) ? JSON.stringify({ d, m }) : null,
  };
});
const lengte = heeftP4 ? PIN : Number((PIN * (1 - (P4[1] - P4[0]))).toFixed(2));

/** De kern als uitsnede: zestien punten rond het midden, straal uit `--piek-straal`. */
const kernPad = hoeken(0, 22.5, 16)
  .map((graden, i) => {
    const a = (graden * Math.PI) / 180;
    const f = i % 2 === 0 ? 1 : KERN_INKEPING / KERN_PUNT;
    const x = (f * Math.cos(a)).toFixed(4);
    const y = (-f * Math.sin(a)).toFixed(4);
    return `calc(50% + var(--piek-straal) * ${x}) calc(50% + var(--piek-straal) * ${y})`;
  })
  .join(', ');

const rijen: Sleutelrij[] = (['p1', 'p2', 'p3'] as const).map((naam, i) => ({
  beeld: { shot: naam },
  tekst: slagen[i] ?? '',
}));
---

<section
  id="piek-ruimtes"
  class="piek-ruimtes"
  data-sectie="piek-ruimtes"
  data-lengte={lengte}
  data-sprong={heeftP4 ? undefined : P4.join(',')}
  style={`--piek-lengte:${lengte}`}
>
  <div class="sh-maat" aria-hidden="true"></div>
  <div class="piek-podium">
    <div class="piek-beeld alleen-beweging">
      <div class="piek-kern" style={`--kern-pad: polygon(${kernPad})`}>
        <div class="piek-fotos">
          {
            lagen.map(({ naam, laag, fase, vorm, film: filmData }) => (
              <div class="piek-laag" data-laag={laag} data-vorm={vorm} style={`--van:${fase.van};--tot:${fase.tot}`}>
                <picture>
                  {poster(naam, 'm').avif ? (
                    <source media="(max-width: 47.9375rem)" type="image/avif" srcset={poster(naam, 'm').avif} />
                  ) : null}
                  <source media="(max-width: 47.9375rem)" srcset={poster(naam, 'm').pad} />
                  {poster(naam, 'd').avif ? <source type="image/avif" srcset={poster(naam, 'd').avif} /> : null}
                  <img
                    class:list={['piek-foto', vorm === 'poster' ? 'piek-zoom' : null]}
                    data-shot={naam}
                    src={poster(naam, 'd').pad}
                    width={poster(naam, 'd').breedte}
                    height={poster(naam, 'd').hoogte}
                    alt={alt(naam, locale)}
                    loading="lazy"
                    decoding="async"
                    style={`--anker-d:${anker(naam, 'd')};--anker-m:${anker(naam, 'm')}`}
                  />
                </picture>
                {filmData ? (
                  <video
                    class="piek-film"
                    data-film-shot={naam}
                    data-film={filmData}
                    data-van={fase.van}
                    data-tot={fase.tot}
                    muted
                    playsinline
                    preload="none"
                    aria-hidden="true"
                    tabindex="-1"
                    style={`--anker-d:${anker(naam, 'd')};--anker-m:${anker(naam, 'm')}`}
                  />
                ) : null}
                {vorm === 'poster' ? <span class="piek-licht" data-licht={naam} aria-hidden="true" /> : null}
                {vorm === 'poster' ? <span class="piek-diepte" aria-hidden="true" /> : null}
                <MediaVermelding shot={naam} locale={locale} class="piek-vermelding" />
              </div>
            ))
          }
        </div>
      </div>
      <svg class="piek-rozet" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
        <path d={lijnen.cirkel}></path>
        <path d={lijnen.a}></path>
        <path d={lijnen.b}></path>
        <path d={lijnen.binnen}></path>
        <path d={lijnen.kern}></path>
      </svg>
      <svg class="piek-ster" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
        <path d={lijnen.cirkel}></path>
        <path d={lijnen.a}></path>
        <path d={lijnen.b}></path>
        <path class="piek-ster-kern" d={lijnen.kern}></path>
      </svg>
    </div>

    <h2 class="piek-kop">{opening}</h2>

    <div class="piek-tekst alleen-beweging">
      <p class="piek-klein" aria-hidden="true">
        <span>{opening}</span>
        {slagen[0] ? <span data-na="2"> {slagen[0]}</span> : null}
        {slagen[1] ? <span data-na="3"> {slagen[1]}</span> : null}
      </p>
      <div class="piek-slagen">
        {
          slagen.slice(0, 3).map((slag, i) => (
            <p class="piek-slag" data-slag={i + 1}>
              {slag}
            </p>
          ))
        }
      </div>
      <div class="piek-knoppen" data-piek-knoppen="scene">
        <a class="knop knop-eerst" href="#steun">{t.donateCta}</a>
        <a class="knop knop-tweede" href="#contact">{teksten.contactKop}</a>
      </div>
    </div>

    <div class="piek-stil alleen-stil">
      <Sleutelbeelden rijen={rijen} locale={locale} soort="foto" class="piek-sleutels" />
      <div class="piek-knoppen">
        <a class="knop knop-eerst" href="#steun">{t.donateCta}</a>
        <a class="knop knop-tweede" href="#contact">{teksten.contactKop}</a>
      </div>
    </div>
  </div>
</section>
