---
/**
 * De eerlijke vermelding bij een shot (CONTRACT 3, moskee-zorg).
 *
 * Twee regels, elk alleen als het manifest het zegt:
 * - "Film: AI-gegenereerd" als het shot een AI-film toont (`aiFilm` plus een
 *   film of frame-reeks die er ligt; bij alleen de poster is er geen AI in beeld,
 *   ook niet als de film van dat shot "vervallen" is);
 * - "Foto bijgewerkt" als de poster een bewerkte foto is.
 *
 * Met de plaatshouder geeft het manifest geen van beide: dan staat er niets, ook
 * geen leeg element.
 *
 * De AI-regel hoort bij de getoonde vorm, niet bij het shot (keuring F2a): zonder
 * JavaScript of met reduced motion staat alleen de poster in beeld, dus dan is ze
 * verborgen. Ze verschijnt pas als de scène `uccib:film-klaar` voor dit shot meldt
 * (klasse `is-getoond`) en alleen in de bewegingsstand. Is zij de enige regel, dan
 * verdwijnt het hele plaatje mee.
 */
import type { Locale } from '../i18n';
import { f3 } from '../i18n/f3';
import { shot, vermelding, vormVan, type ShotNaam } from '../lib/media';

interface Props {
  shot: ShotNaam;
  locale: Locale;
  class?: string;
}

const { shot: naam, locale, class: klasse } = Astro.props;
const teksten = f3(locale);
// De film is de enige vorm met AI; of hij echt getoond wordt, beslist de scène.
const ai = vermelding(naam, 'film', locale) ?? (vormVan(naam) === 'film' && shot(naam).aiFilm ? teksten.mediaAi : null);
const bewerkt = shot(naam).bewerkt ? teksten.mediaBewerkt : null;
---

{
  ai || bewerkt ? (
    <p class:list={['media-vermelding', klasse, { 'vermelding-film': !bewerkt }]} data-vermelding={naam}>
      {ai ? (
        <span class="vermelding-film" data-vermelding-film={naam}>
          {ai}
        </span>
      ) : null}
      {bewerkt ? <span>{bewerkt}</span> : null}
    </p>
  ) : null
}

<style>
  /* Alleen bij een getoonde film (zie boven); anders staat de poster in beeld. */
  .vermelding-film,
  .media-vermelding.vermelding-film {
    display: none;
  }
  @media (min-height: 35rem) {
    :global(html.beweging-aan:not(.home-stil)) .vermelding-film:global(.is-getoond) {
      display: inline;
    }
    :global(html.beweging-aan:not(.home-stil)) .media-vermelding.vermelding-film:global(.is-getoond) {
      display: flex;
    }
  }
  .media-vermelding {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.75rem;
    font-family: var(--font-tekst);
    font-size: var(--text-label);
    line-height: var(--text-label--line-height);
    letter-spacing: var(--text-label--letter-spacing);
    font-weight: var(--text-label--font-weight);
    color: var(--color-inkt);
    background: var(--plaat);
    padding: 0.125rem 0.5rem;
    border-radius: var(--radius-vak);
  }
</style>
