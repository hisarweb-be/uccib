---
import '../styles/tokens.css';
import '../styles/tekst.css';
import '../styles/cinema.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsApp from '../components/WhatsApp.astro';
import { SITE } from '../data/site';
import { LOCALES, LOCALE_TAGS, type Locale, getDictionary } from '../i18n';
import { pagePath } from '../i18n/config';
import type { Slug } from '../data/site';

interface Props {
  locale: Locale;
  /**
   * De slug van deze pagina, of null voor een pagina die geen eigen inhoud heeft
   * (de 404 en de conceptpagina's). Zonder slug leidt de layout geen canonical en
   * geen hreflang-wissels af; de aanroeper geeft dan `path` zelf mee.
   */
  slug: Slug | null;
  /** Pad van deze route. Nodig zodra `slug` null is, want dan valt er niets af te leiden. */
  path?: string;
  /**
   * Het pad van deze pagina in elke taal, als dat niet uit `slug` volgt.
   * Dat geldt voor de stadspagina's van de gebedstijden: hun adres draagt de stad
   * (`/namaz-vakitleri/gent/`), en de vertaling daarvan is dezelfde slug in een
   * andere taal, niet een andere pagina. Zonder deze prop leidt de layout de
   * hreflang-wissels af uit `slug` en die kent geen stad.
   */
  taalPaden?: Record<Locale, string>;
  title: string;
  description: string;
  /** Houd deze pagina buiten de zoekmachines. Geldt voor 404 en conceptpagina's. */
  noindex?: boolean;
  /**
   * Laat `main` zonder eigen breedtebegrenzing. Nodig voor pagina's met een
   * band die van rand tot rand loopt (de held op de homepage); die pagina zet
   * zijn eigen `max-w-6xl`-kolom binnen de band.
   */
  volleBreedte?: boolean;
}

const {
  locale,
  slug,
  path,
  taalPaden,
  title,
  description,
  noindex = false,
  volleBreedte = false,
} = Astro.props;
const t = getDictionary(locale);

const routePath = path ?? (slug === null ? '/' : pagePath(locale, slug as Slug));
/**
 * Geen canonical op een pagina die noindex draagt. De 404 heeft geen eigen URL
 * (Cloudflare toont hem op elk onbekend pad) en een concept is tijdelijk; een
 * canonical naar een adres dat geen inhoud heeft, is een verkeerde verklaring
 * aan de zoekmachine. Zonder canonical is er ook geen og:url om te delen.
 */
const canonical = noindex ? null : new URL(routePath, SITE.url).href;

/** Open Graph-beeld per taal, uit de beeldset van F1. */
const ogImage = new URL(`/beeld/og/og-1200x630-${locale}.png`, SITE.url).href;

/**
 * Zelfde pagina in elke taal, voor de hreflang-verwijzingen. Alleen als er een
 * slug is: een conceptpagina heeft geen eigen inhoud en staat op noindex, dus
 * drie talen naar elkaar verwijzen zou drie lege pagina's aan elkaar knopen.
 * `taalPaden` gaat voor: een stadspagina heeft een eigen adres per taal.
 */
const alternates: ReadonlyArray<{ hreflang: string; href: string }> =
  taalPaden
    ? LOCALES.map((other) => ({
        hreflang: LOCALE_TAGS[other].html,
        href: new URL(taalPaden[other], SITE.url).href,
      }))
    : slug === null
      ? []
      : LOCALES.map((other) => ({
          hreflang: LOCALE_TAGS[other].html,
          href: new URL(pagePath(other, slug), SITE.url).href,
        }));
const xDefault = alternates[0]?.href;
---

<!doctype html>
<html lang={LOCALE_TAGS[locale].html}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/*
      Twee vlaggen vóór de eerste verf (CONTRACT 5.2): `js-aan` zodra er JavaScript
      is (het menu wordt dan een knop met een modaal blad, zonder flits van de open
      lijst), `beweging-aan` alleen als de bezoeker geen minder beweging vraagt.
    */}
    <script is:inline>(function(d){d.classList.add('js-aan');if(window.matchMedia&&matchMedia('(prefers-reduced-motion: no-preference)').matches)d.classList.add('beweging-aan')})(document.documentElement)</script>
    {/* Beide letters vooraf: komt de broodletter pas na de eerste opmaak, dan wordt
        alle tekst opnieuw gezet (keuring F2b, herstelpunt 1: lange taak na het eerste scherm). */}
    <link rel="preload" href="/fonts/platypi-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/atkinson-next-var.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {
      alternates.map((alt) => (
        <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
      ))
    }
    {xDefault && <link rel="alternate" hreflang="x-default" href={xDefault} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t.siteName} />
    <meta property="og:locale" content={LOCALE_TAGS[locale].og} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.logoAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content={SITE.themeColor} />
    <link rel="icon" href="/beeld/logo/favicon.ico" sizes="any" />
    <link rel="icon" href="/beeld/logo/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/beeld/logo/icon-192.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {/*
      De schakelaar van de bewegingslaag (F4). Deze regel staat bewust inline en
      vóór alles wat tekent: zo is de beginstand van het podium er al bij de eerste
      verf, zonder flits van de eindfoto. Vraagt de bezoeker minder beweging, dan
      komt de klasse er niet en staat de site stil. De noodrem onderaan ruimt de
      beginstand op als `src/scripts/cinema.ts` nooit geladen raakte.
    */}
    <script is:inline>
      (function () {
        var wortel = document.documentElement;
        if (!window.matchMedia) return;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        wortel.classList.add('cinema-aan');
        setTimeout(function () {
          if (!window.__cinema) wortel.classList.remove('cinema-aan');
        }, 2500);
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#hw-main">{t.skipToContent}</a>
    <Header locale={locale} slug={slug} />
    <main
      id="hw-main"
      tabindex="-1"
      class={
        volleBreedte
          ? 'w-full'
          : 'mx-auto w-full max-w-6xl px-4 py-10 sm:px-6 lg:px-8'
      }
    >
      <slot />
    </main>
    <Footer locale={locale} />
    <WhatsApp locale={locale} />
    <script>
      import '../scripts/cinema';
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 100;
    padding: 0.75rem 1.25rem;
    background: var(--color-brand-dark);
    color: #fff;
    font-weight: 600;
    text-decoration: none;
  }

  .skip-link:focus {
    left: 0.5rem;
    top: 0.5rem;
    text-decoration: underline;
  }

  main:focus {
    outline: none;
  }
</style>
