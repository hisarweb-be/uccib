---
/**
 * De echte 404.
 *
 * Zonder dit bestand levert de bouw geen dist/404.html en ziet Cloudflare Pages
 * het project als een single-page app: elk onbekend pad krijgt dan de homepage
 * met status 200. Dat is gemeten op 16 november 2026 (een fout pad, een
 * verdwenen scriptbestand en een niet-bestaand beeld gaven alle drie 200 met
 * precies de homepage). Met dit bestand antwoordt Pages met 404 en deze pagina.
 *
 * Bewust in het Turks, de standaardtaal, zonder taalkeuze-cluster: een 404 hoort
 * niet in de sitemap en niet in de hreflang-set.
 *
 * De statuscode komt van Cloudflare, niet van Astro: een statische bouw schrijft
 * dist/404.html en Pages antwoordt daarmee 404 op elk pad dat geen bestand is.
 * Dat is precies de meting die na de uitrol moet kloppen.
 */
import Layout from '../layouts/Layout.astro';
import { SITE } from '../data/site';
import { getDictionary } from '../i18n';

const locale = 'tr' as const;
const t = getDictionary(locale);

---
<Layout
  locale={locale}
  slug={null}
  path="/404/"
  title={`Sayfa bulunamadı — ${t.siteName}`}
  description="Aradığınız sayfa bulunamadı. UCCIB vakfının güncel bilgilerine ana sayfadan ulaşabilirsiniz."
  noindex
>
  <div class="niet-gevonden">
    <p class="code">404</p>
    <h1>Sayfa bulunamadı</h1>
    <p class="uitleg">
      Aradığınız sayfa taşınmış of kaldırılmış olabilir. Ana sayfadan devam edebilir veya bize
      doğrudan ulaşabilirsiniz.
    </p>

    <dl class="contact">
      <div>
        <dt>{t.footer.phone}</dt>
        <dd><a href={`tel:${SITE.phoneHref}`}>{SITE.phone}</a></dd>
      </div>
      <div>
        <dt>{t.footer.email}</dt>
        <dd><a href={`mailto:${SITE.email}`}>{SITE.email}</a></dd>
      </div>
    </dl>

    <p class="home"><a href="/">Ana sayfaya dön</a></p>
  </div>
</Layout>

<style>
  .niet-gevonden {
    max-width: 34rem;
    padding: 2rem 0 4rem;
  }

  .code {
    font-family: var(--font-head);
    font-size: clamp(48px, 3rem + 4vw, 92px);
    line-height: 1;
    font-weight: 700;
    color: var(--color-brand);
  }

  .uitleg {
    margin-top: 1rem;
    color: var(--color-ink-muted);
  }

  .contact {
    display: grid;
    gap: 0.75rem;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-line);
    font-size: var(--text-small);
  }

  .contact dt {
    font-weight: 600;
    color: var(--color-ink-muted);
  }

  .home {
    margin-top: 2rem;
  }

  .home a {
    display: inline-block;
    padding: 12px 28px;
    border-radius: var(--radius-pill);
    background: var(--color-brand-dark);
    color: #fff;
    font-weight: 600;
    text-decoration: none;
  }

  .home a:hover,
  .home a:focus-visible {
    background: var(--color-ink);
  }
</style>
