{
  "name": "uccib-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "UCCIB, statische site in drie talen (Astro 5, Tailwind 4)",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/lever-vakitler.mjs && astro build && node scripts/lib/taal-404.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "vakitler": "node scripts/lever-vakitler.mjs",
    "verify": "node scripts/verify-alle.mjs",
    "verify:page": "node scripts/verify-pagina.mjs",
    "verify:server": "node scripts/verify-server.mjs",
    "verify:links": "node scripts/verify-links.mjs",
    "verify:elke": "node scripts/verify-een-voor-een.mjs",
    "verify:mobiel": "node scripts/verify-mobiel.mjs",
    "verify:scherm": "node scripts/verify-eerste-scherm.mjs",
    "verify:live": "node scripts/verify-een-voor-een.mjs --basis=https://uccib.com",
    "verify:sponsor": "node scripts/verify-sponsor.mjs",
    "verify:media": "node scripts/verify-media.mjs",
    "verify:tekens": "node scripts/verify-tekens.mjs",
    "verify:betaallinks": "node scripts/verify-betaallinks.mjs",
    "verify:menu": "node scripts/verify-menu.mjs",
    "verify:leeg": "node scripts/leeg-scherm.mjs",
    "verify:verhuis": "node scripts/verify-verhuis.mjs",
    "verify:cms": "node scripts/verify-cms.mjs",
    "verify:cms:levend": "node scripts/verify-cms.mjs --levend"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^5.18.2",
    "gsap": "3.15.1",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "playwright": "^1.65.1",
    "typescript": "^5.9.3"
  }
}
