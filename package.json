{
  "name": "uccib-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "UCCIB vzw — statische site in drie talen (Astro 5, Tailwind 4)",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/build-studio.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "verify": "node scripts/verify-alle.mjs",
    "verify:page": "node scripts/verify-pagina.mjs",
    "verify:links": "node scripts/verify-links.mjs",
    "cms:fallback": "node scripts/build-fallback.mjs",
    "cms:import": "node scripts/import-sanity.mjs",
    "cms:verify": "node scripts/verify-cms.mjs",
    "cms:verify:offline": "node scripts/verify-cms.mjs --offline",
    "sanity:dev": "npm --prefix sanity run dev",
    "sanity:build": "node scripts/build-studio.mjs",
    "sanity:typecheck": "npm --prefix sanity run typecheck"
  },
  "dependencies": {
    "@astrojs/react": "^4.4.2",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/noto-serif": "^5.3.0",
    "@fontsource-variable/open-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^5.18.2",
    "react": "^19.2.9",
    "react-dom": "^19.2.9",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "playwright": "^1.65.1",
    "typescript": "^5.9.3"
  }
}
